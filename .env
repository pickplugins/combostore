# --- Stripe (hosted Checkout) ---
# From https://dashboard.stripe.com/apikeys - sk_test_... while developing.
STRIPE_SECRET_KEY=
# From the endpoint you add at https://dashboard.stripe.com/webhooks
# (<NEXT_PUBLIC_APP_URL>/api/stripe/webhook, event checkout.session.completed),
# or from `stripe listen` locally. Without it the webhook refuses everything.
STRIPE_WEBHOOK_SECRET=
# What cards are actually charged in. Stripe does not take BDT, so a store
# priced in taka charges in this currency instead.
STRIPE_CURRENCY=USD
# Units of the store's currency per 1 of STRIPE_CURRENCY (e.g. 120 for BDT per
# USD). Only needed when the two differ; leave blank when they match.
STRIPE_EXCHANGE_RATE=

