# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# extra build folders (NEXT_DIST_DIR, e.g. a second instance beside the dev server) - Tailwind skips what is ignored here
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# .env stays committed (app version, beta flag, commented URLs) - no secrets in it.
# Secrets and local URLs go in .env.local, which is ignored.
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated by scripts/build-tabler-icons.mjs (npm predev / prebuild)
/lib/icons/tabler-icons.json

# cloudflare (@opennextjs/cloudflare, wrangler)
/.open-next/
/.wrangler/
.dev.vars*

# generated by scripts/build-tailwind-sources.mjs (npm predev / prebuild)
/lib/tailwindSources.json
