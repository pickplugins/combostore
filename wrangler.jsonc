/*
	Cloudflare Workers hosting, built with @opennextjs/cloudflare
	(npm run cf:build / cf:preview / cf:deploy). Vercel ignores this file.

	Before the first deploy, create the cache bucket once:
	  npx wrangler r2 bucket create kidobazar-cache

	If you rename the Worker, change "name" and the WORKER_SELF_REFERENCE
	service together - they must match.
*/
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kidobazar",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

	/* The built static files (/_next/static, /public). */
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	/* Variables and secrets set in the Cloudflare dashboard survive a deploy. */
	"keep_vars": true,

	"services": [
		{ "binding": "WORKER_SELF_REFERENCE", "service": "kidobazar" }
	],

	/* Next's data cache: fetch(..., { next: { revalidate } }) results and
	   rendered pages (open-next.config.ts). */
	"r2_buckets": [
		{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "kidobazar-cache" }
	],

	/* NEXT_CACHE_DO_QUEUE refreshes stale entries in the background;
	   NEXT_TAG_CACHE_DO_SHARDED records revalidateTag() calls
	   (app/api/revalidate-template-settings). Both are created by the deploy. */
	"durable_objects": {
		"bindings": [
			{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
			{ "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }
	],

	/* next/image resizing through Cloudflare Images (billed per unique
	   transformation beyond the free allowance). */
	"images": {
		"binding": "IMAGES"
	},

	"observability": {
		"enabled": true
	}
}
